# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#240a35"

# Main text color
theme[main_fg]="#fbe9ff"

# Title color for boxes
theme[title]="#ffd23f"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff2fa4"

# Background color of selected item in processes box
theme[selected_bg]="#ff2fa4"

# Foreground color of selected item in processes box
theme[selected_fg]="#1a0727"

# Color of inactive/disabled text
theme[inactive_fg]="#7a3f96"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e2c8ee"

# Background color of the percentage meters
theme[meter_bg]="#5c1f6e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e2c8ee"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ff2fa4"
theme[mem_box]="#ffd23f"
theme[net_box]="#3ee8ff"
theme[proc_box]="#ff9e3d"

# Box divider line and small boxes line color
theme[div_line]="#7a3f96"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#9dff6a"
theme[temp_mid]="#ffd23f"
theme[temp_end]="#ff3b6b"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#ffd23f"
theme[cpu_mid]="#ff9e3d"
theme[cpu_end]="#ff2fa4"

# Mem/Disk free meter
theme[free_start]="#ff2fa4"
theme[free_mid]="#8a7cff"
theme[free_end]="#3ee8ff"

# Mem/Disk cached meter
theme[cached_start]="#8a7cff"
theme[cached_mid]="#3ee8ff"
theme[cached_end]="#ff2fa4"

# Mem/Disk available meter
theme[available_start]="#ffd23f"
theme[available_mid]="#ff3b6b"
theme[available_end]="#ff3b6b"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#9dff6a"
theme[used_mid]="#3ee8ff"
theme[used_end]="#8a7cff"

# Download graph colors
theme[download_start]="#ffd23f"
theme[download_mid]="#ff3b6b"
theme[download_end]="#ff3b6b"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#9dff6a"
theme[upload_mid]="#3ee8ff"
theme[upload_end]="#8a7cff"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#3ee8ff"
theme[process_mid]="#8a7cff"
theme[process_end]="#ff2fa4"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#240a35"
theme[gradient_color_1]="#38124f"
theme[gradient_color_2]="#5c1f6e"
theme[gradient_color_3]="#7a3f96"
theme[gradient_color_4]="#c08fd6"
theme[gradient_color_5]="#fbe9ff"
theme[gradient_color_6]="#e2c8ee"
theme[gradient_color_7]="#ffffff"
